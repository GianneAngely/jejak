{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/brand?f=page&p=landing" },
    { "source": "/app", "destination": "/api/brand?f=page&p=app" },
    { "source": "/app.js", "destination": "/web/app.js" },
    { "source": "/app.css", "destination": "/web/app.css" },
    { "source": "/sw.js", "destination": "/web/sw.js" },
    { "source": "/manifest.webmanifest", "destination": "/api/brand?f=manifest" },
    { "source": "/brand.js", "destination": "/api/brand" },
    { "source": "/icon.svg", "destination": "/web/icon.svg" },
    { "source": "/icon-512.png", "destination": "/web/icon-512.png" },
    { "source": "/apple-touch-icon.png", "destination": "/web/apple-touch-icon.png" }
  ],
  "headers": [
    { "source": "/(app.js|app.css|sw.js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 30, "includeFiles": "{landing,web}/index.html" }
  }
}
