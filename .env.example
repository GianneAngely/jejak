# Jejak: env di Vercel (Project > Settings > Environment Variables)
# Otomatis dari integrasi: POSTGRES_URL (Neon), BLOB_READ_WRITE_TOKEN (Vercel Blob)
# AI opsional (scan struk + saran anggaran), hanya Gemini. Kosong = fitur AI mati, app tetap jalan.
GEMINI_API_KEY=
AI_MODEL=            # opsional, mis. gemini-flash-latest
