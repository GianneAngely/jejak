# Sangu: env di Vercel (Project > Settings > Environment Variables)
# Otomatis dari integrasi: POSTGRES_URL (Neon), BLOB_READ_WRITE_TOKEN (Vercel Blob)
# AI opsional (scan struk + saran anggaran). Isi salah satu; kosong = fitur AI mati, app tetap jalan.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=            # opsional, mis. gemini-flash-latest atau claude-sonnet-5-5
